# ── MT5 File Bridge ──────────────────────────────
MT5_SESSION_PREFIX=signal
# MT5 Common Files path — auto-detected on Windows, override if needed
# MT5_FILES_PATH=C:\Users\...\AppData\Roaming\MetaQuotes\Terminal\Common\Files

# ── AI Provider ──────────────────────────────────
AI_PROVIDER=claude         # claude | openai | deepseek | gemini | ollama
AI_API_KEY=                # paste your Claude API key here
AI_MODEL=claude-haiku-4-5  # cheapest current Claude model, ~$0.20/month at this volume
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=phi3          # fallback only — not recommended as primary

# ── Telegram (channel listener) ──────────────────
TELEGRAM_API_ID=...
TELEGRAM_API_HASH=...
TELEGRAM_SESSION_NAME=signal_session

# ── Telegram (bot notifications) ─────────────────
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...

# ── Dashboard ────────────────────────────────────
DASHBOARD_PORT=8501
# ── Account-level kill switch ────────────────────
# Halts EVERY channel for the rest of the UTC day once the account's combined
# realised + floating P&L is this far down. Per-channel drawdown_pct bounds each
# channel in isolation and therefore bounds nothing in aggregate: 28 channels
# each permitted a 30% loss on a $1000 book is $8,400 of permitted loss.
# This is the only ceiling on the account itself.
# Open positions are NOT closed - it stops new entries only.
# 0 disables it. Default 10.
ACCOUNT_MAX_DAILY_LOSS_PCT=10

# ── Bare-call runner ─────────────────────────────────────────────────────────
# A bare "gold buy now" opens with a protective stop and NO take profit. Once
# it is this many R in its own favour (R = its own stop distance), the EA's
# trailing engine takes the stop over and follows price. This is deliberately
# not a fixed target at 1R: a hard TP there would close every bare trade at
# exactly 1R, including the ones that were about to run.
RUNNER_TRAIL_ARM_R=1.0
